<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /agenda/

  # Si el archivo existe físicamente, no hagas nada (déjalo pasar)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Si NO existe, podrías redirigir al index (opcional para SPA)
  # RewriteRule . index.html [L]
</IfModule>